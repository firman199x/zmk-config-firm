#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define SPECIAL 3

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
 &kp DEL   &kp F1    &kp F2    &kp F3    &kp F4   &kp F5 &kp C_MUTE    /**/     &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
 &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4   &kp N5 &kp K_VOL_UP  /**/     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL
 &trans    &kp Q     &kp W     &kp E     &kp R    &kp T  &kp K_VOL_DN  /**/     &kp LBKT  &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
 &trans    &kp A     &kp S     &kp D     &kp F    &kp G  &kp LGUI      /**/     &kp RBKT  &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
 &kp ESC   &kp Z     &kp X     &kp C     &kp V    &kp B                /**/               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp ENTER
 &mo RAISE &mo LOWER &kp LEFT  &kp RIGHT                               /**/                                   &kp DOWN  &kp UP    &mo LOWER &mo SPECIAL
 &kp TAB   &kp LSHFT &kp LCTRL &kp HOME  &kp END  &kp LALT             /**/               &kp RALT  &kp RCTRL &kp RSHFT &kp SPACE &kp BSPC  &kp DEL
			>;
		};

		lower_layer {
			bindings = <
 &kp DEL   &kp F1    &kp F2    &kp F3    &kp F4   &kp F5 &kp C_MUTE    /**/     &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
 &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4   &kp N5 &kp PG_UP     /**/     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL
 &trans    &kp Q     &kp W     &kp E     &kp R    &kp T  &kp PG_DN     /**/     &kp LBKT  &kp Y     &kp U     &kp I     &kp LBKT  &kp RBKT  &kp BSLH
 &trans    &kp HASH  &kp S     &kp D     &kp F    &kp G  &kp LGUI      /**/     &kp RBKT  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp SEMI  &kp SQT
 &kp ESC   &kp TILDE &kp X     &kp C     &kp V    &kp B                /**/               &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC  &kp FSLH  &kp ENTER
 &trans    &trans    &kp LEFT  &kp RIGHT                               /**/                                   &kp DOWN  &kp UP    &trans    &trans
 &kp TAB   &kp LSHFT &kp LCTRL &kp HOME  &kp END  &kp LALT             /**/               &kp RSHFT &kp SPACE &kp BSPC  &kp DEL   &kp RALT  &kp RCTRL
			>;
		};

		raise_layer {
			bindings = <
 &kp DEL   &kp F1    &kp F2    &kp F3    &kp F4   &kp F5 &kp C_MUTE    /**/     &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
 &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4   &kp N5 &kp PG_UP     /**/     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL
 &trans    &kp Q     &kp W     &kp E     &kp R    &kp T  &kp PG_DN     /**/     &kp LBKT  &kp Y     &kp N7    &kp N8    &kp N9    &kp P     &kp BSLH
 &trans    &kp A     &kp S     &kp D     &kp F    &kp G  &kp LGUI      /**/     &kp RBKT  &kp H     &kp N4    &kp N5    &kp N6    &kp SEMI  &kp SQT
 &kp ESC   &kp Z     &kp X     &kp C     &kp V    &kp B                /**/               &kp N     &kp N1    &kp N2    &kp N3    &kp FSLH  &kp ENTER
 &trans    &trans    &kp LEFT  &kp RIGHT                               /**/                                   &kp N0    &kp DOT   &trans    &trans
 &kp TAB   &kp LSHFT &kp LCTRL &kp HOME  &kp END  &kp LALT             /**/               &kp RSHFT &kp SPACE &kp BSPC  &kp DEL   &kp RALT  &kp RCTRL
			>;
		};

		special_layer {
			bindings = <
 &sys_reset        &bootloader  &trans         &trans       &trans        &trans    &trans    /**/    &trans    &trans    &trans    &trans    &trans    &bootloader &sys_reset
 &bt BT_CLR        &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_SEL 3  &trans    &trans     /**/   &trans    &trans    &trans    &trans    &trans    &trans      &trans
 &trans            &trans       &trans         &trans       &trans        &trans    &trans    /**/    &trans    &trans    &trans    &trans    &trans    &trans      &trans
 &trans            &trans       &trans         &trans       &trans        &trans    &trans    /**/    &trans    &trans    &trans    &trans    &trans    &trans      &trans
 &studio_unlock    &trans       &trans         &trans       &trans        &trans              /**/              &trans    &trans    &trans    &trans    &trans      &trans
 &trans            &trans       &trans         &trans                                         /**/                                  &trans    &trans    &trans      &trans
 &studio_unlock    &trans       &trans         &trans       &trans        &trans              /**/              &trans    &trans    &trans    &trans    &trans      &trans
			>;
		};

		extra_5 {
			status = "reserved";
		};
		extra_6 {
			status = "reserved";
		};
		extra_7 {
			status = "reserved";
		};
		extra_8 {
			status = "reserved";
		};
		extra_9 {
			status = "reserved";
		};
		extra_10 {
			status = "reserved";
		};
		extra_11 {
			status = "reserved";
		};
		extra_12 {
			status = "reserved";
		};
		extra_13 {
			status = "reserved";
		};
		extra_14 {
			status = "reserved";
		};
		extra_15 {
			status = "reserved";
		};
		extra_16 {
			status = "reserved";
		};
	};
};

